{
  "name": "portfolio-axel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"client,server\" --prefix-colors \"cyan,magenta\" \"vite\" \"bun --watch server.ts\"",
    "dev:client": "vite",
    "dev:server": "bun --watch server.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "seed:i18n": "bun scripts/seed-i18n.ts",
    "db:push:prod": "drizzle-kit push --config=drizzle.config.prod.ts",
    "db:studio:prod": "drizzle-kit studio --config=drizzle.config.prod.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.5.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.0.5",
    "multer": "^2.2.0",
    "postgres": "^3.4.8",
    "resend": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "vue": "^3.5.24",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
