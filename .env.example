#DATABASES - LOCAL COMMANDS
#Both point at the server through an SSH tunnel: the two databases live in the
#compose stack and publish their ports on 127.0.0.1 only.
#DATABASE_URL is ALWAYS the dev one. bun run dev, db:push and db:studio target it
#and nothing else. Production is a separate variable, so every command that
#touches production says so by name - there is no flag to forget.
#The port in each URL is the tunnel's local port, matching the two below.
DATABASE_URL=postgresql://user:password@localhost:5450/dbname_dev
PROD_DATABASE_URL=postgresql://user:password@localhost:5449/dbname

#DATABASES IN THE STACK (docker-compose.yml only)
#One Dokploy compose service named "stack" holds the app and both databases. The
#app is wired to the production one by service name over the private network; the
#dev one is there for the tunnel and nothing connects to it from inside.
#Both share these credentials; the dev database is named <POSTGRES_DB>_dev.
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
#host ports for the SSH tunnels, bound to 127.0.0.1 only. Both must be unique
#across every project on the server. Taken at the last check: 5433, 5436-5448.
#Read the list again before adding a project, do not trust this comment:
#  ssh vps "ss -tlnp | grep :54"
DB_HOST_PORT=5449
DB_DEV_HOST_PORT=5450

#BETTER-AUTH
#generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
#url of the express server (better-auth callbacks land here)
BETTER_AUTH_URL=http://localhost:3001
#public-facing app URL (written into the password reset link)
PUBLIC_APP_URL=http://localhost:5173
#comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

#THERE IS NO AUTH MODE AND NO SIGN-UP FORM.
#This site has exactly one account. Deploy, open /login once, create it, then set
#its role to admin directly in the database:
#  UPDATE "user" SET role = 'admin' WHERE email = '...';
#From the moment one account exists, /sign-up/email answers 400 to everyone, and
#the next boot deletes every account that is not the admin.

#DEV-ONLY proxy overrides, read by vite.config.ts. Leave both empty to use the
#local Express at :3001. Set them to the prod base URL to read prod's data and
#media from a dev front end.
VITE_API_BASE_URL=
VITE_MEDIA_BASE_URL=


#EMAIL (Resend - https://resend.com)
#one letter is sent by this site: the password reset. Leave RESEND_API_KEY empty
#in dev to log it to the console instead of sending it.
RESEND_API_KEY=
#the Resend sandbox sender delivers to the account owner and nobody else
EMAIL_FROM=
APP_NAME=Axel Offret
