#DATABASE
DATABASE_URL=postgresql://user:password@host:5432/dbname

#BETTER-AUTH
#generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
#url of the express server (better-auth callbacks land here)
BETTER_AUTH_URL=http://localhost:3001
#public-facing app URL (used in emails for reset/verify links)
PUBLIC_APP_URL=http://localhost:5173
#comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

#AUTH MODE: public (no auth) | open (anyone can register) | restricted (admin must approve)
#Portfolio-Axel defaults to public - the site is fully open
VITE_AUTH_MODE=public

#DEV: vite proxy target. /api goes here. Leave empty (default
#http://localhost:3001) when running `bun dev` so the local Express
#handles auth - Google OAuth callbacks have to land on localhost for the
#session cookie to be usable. Point at prod to skip the local Express.
VITE_API_BASE_URL=

#DEV: optional separate target for /media. Useful when /api is local
#(local auth) but you want images + .glb files to come from the prod
#volume so you don't keep a local storage folder. Defaults to whatever
#VITE_API_BASE_URL is.
VITE_MEDIA_BASE_URL=

#GOOGLE OAUTH (optional - if empty, the Google button shows but clicking fails)
#create credentials at https://console.cloud.google.com -> OAuth 2.0 Client ID -> Web application
#Authorized redirect URIs:
#  http://localhost:3001/api/auth/callback/google
#  https://your-domain.tld/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#EMAIL (Resend - https://resend.com)
#used for email verification + password reset
#leave RESEND_API_KEY empty in dev to log emails to the console instead of sending
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
APP_NAME=My App
